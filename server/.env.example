# PostgreSQL connection string (Neon / Supabase / Prisma Postgres / local).
# Use the *direct* postgres:// URL (append ?sslmode=require for hosted DBs).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/portfolio?sslmode=require"

PORT=5000
NODE_ENV=development

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN=7d

# Dashboard login credentials
ADMIN_EMAIL="asifshahriartauhid@gmail.com"
ADMIN_PASSWORD="change-me-please"

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGIN="https://asiftauhid.me,https://www.asiftauhid.me,http://localhost:3000"
